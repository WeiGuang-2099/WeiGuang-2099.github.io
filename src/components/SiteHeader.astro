---
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
// "page" on a section's own index page, "true" on pages inside the section (a post, a tag page).
const current = (item: (typeof NAV)[number]) => {
  if (path === item.href) return 'page';
  return item.match(path) ? 'true' : undefined;
};
---
<header class="site-header">
  <div class="container">
    <a class="site-name" href="/" aria-label={`${SITE.name}, home`} aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current(item)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M9 1.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path></svg>
    </button>
  </div>
</header>
