---
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
// "page" on a section's own index page, "true" on pages inside the section (a post, a tag page).
const current = (item: (typeof NAV)[number]) => {
  if (path === item.href) return 'page';
  return item.match(path) ? 'true' : undefined;
};
---
<header class="site-header">
  <div class="container">
    <a class="site-name" href="/" aria-label={`${SITE.name}, home`} aria-current={path === '/' ? 'page' : undefined}>
      {SITE.name}<span class="site-name-zh" lang="zh-CN" aria-hidden="true">{SITE.nameZh}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current(item)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.25"></circle><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path></svg>
    </button>
  </div>
</header>
