---
import { tagUrl } from '../lib/posts';
import type { Locale } from '../lib/i18n';
import { UI } from '../lib/ui';

interface Props {
  tags: string[];
  locale: Locale;
}

const { tags, locale } = Astro.props;
---
{tags.length > 0 && (
  <ul class="tags" aria-label={UI[locale].tagsLabel}>
    {tags.map((tag) => (
      <li><a class="tag" href={tagUrl(tag, locale)}>{tag}</a></li>
    ))}
  </ul>
)}
