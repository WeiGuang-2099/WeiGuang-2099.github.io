---
/*
 * Page shell: <head> (SEO, Open Graph, fonts, theme bootstrap), header, footer and the theme toggle.
 * Fonts are self-hosted from @fontsource. Weight sets are chosen so one CSS weight pairs each script
 * with the face that balances it (CSS font matching rounds a missing 500 up to 600 and a missing
 * 700 down to 600):
 *   font-weight 500 -> Red Hat Display 600 + Noto Sans SC 500   (article title, home name)
 *   font-weight 700 -> Red Hat Display 700 + Noto Sans SC 600   (h2-h4, list titles)
 * Noto Sans SC is split into unicode-range slices, so a page only downloads the slices it uses.
 */
import '@fontsource/red-hat-display/600.css';
import '@fontsource/red-hat-display/700.css';
import '@fontsource/red-hat-text/400.css';
import '@fontsource/red-hat-text/400-italic.css';
import '@fontsource/red-hat-text/500.css';
import '@fontsource/red-hat-text/600.css';
import '@fontsource/red-hat-mono/400.css';
import '@fontsource/red-hat-mono/600.css';
import '../styles/global.css';
// Noto Sans SC's @font-face list is large (one rule per slice and weight), so it is emitted as its own
// stylesheet and linked at the end of <body>, where it does not block rendering.
import notoSansSc from '../styles/noto-sans-sc.css?url';

// "SC Punct": inside Chinese text, quotes, dashes, the ellipsis and the interpunct come from Noto Sans SC
// (full width) instead of the Latin face. These are the self-hosted Noto slices that hold those code points.
import punct400 from '@fontsource/noto-sans-sc/files/noto-sans-sc-latin-400-normal.woff2?url';
import punct500 from '@fontsource/noto-sans-sc/files/noto-sans-sc-latin-500-normal.woff2?url';
import punct600 from '@fontsource/noto-sans-sc/files/noto-sans-sc-latin-600-normal.woff2?url';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';

interface Props {
  /** Page name; omitted on the home page, whose title is just the site name. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  article?: { published: Date; modified?: Date; tags: string[] };
  /** Extra class on <main>. */
  mainClass?: string;
  /** Canonical path when it differs from the URL (the 404 page is served from /404.html). */
  canonicalPath?: string;
  /** Keep the page out of search indexes (the 404 page). */
  noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', article, mainClass, canonicalPath, noindex } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const ogTitle = title ?? SITE.name;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(SITE.ogImage.path, Astro.site ?? SITE.url).href;

const punctFaces = [
  [400, punct400],
  [500, punct500],
  [600, punct600],
]
  .map(
    ([weight, url]) =>
      `@font-face{font-family:"SC Punct";font-style:normal;font-weight:${weight};font-display:swap;` +
      `src:url(${url}) format("woff2");unicode-range:U+00B7,U+2014,U+2018-2019,U+201C-201D,U+2026}`,
  )
  .join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F4F5F7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1115" />
    <script is:inline>
      /* the browser bar follows a theme the reader picked, not only the system (the colors are --bg) */
      function setThemeColor(t) {
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.setAttribute('content', t === 'dark' ? '#0F1115' : '#F4F5F7');
        });
      }
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          setThemeColor(t);
        }
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.ogImage.width)} />
    <meta property="og:image:height" content={String(SITE.ogImage.height)} />
    <meta property="og:image:alt" content={SITE.ogImage.alt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImage.alt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={punctFaces}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <slot name="after-main" />
    <SiteFooter />
    <script is:inline>
      /* theme toggle: follows the system until the reader picks a theme, which is remembered */
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var buttons = document.querySelectorAll('[data-theme-toggle]');
        function effective() { return root.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function sync() {
          var next = effective() === 'dark' ? 'light' : 'dark';
          buttons.forEach(function (b) { b.setAttribute('aria-label', 'Switch to ' + next + ' theme'); b.title = 'Switch to ' + next + ' theme'; });
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            var next = effective() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            setThemeColor(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            sync();
          });
        });
        if (mq.addEventListener) mq.addEventListener('change', sync);
        sync();
      })();
    </script>
    <slot name="scripts" />
    <link rel="stylesheet" href={notoSansSc} />
  </body>
</html>
