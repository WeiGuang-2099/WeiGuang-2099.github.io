---
/*
 * Page shell: <head> (SEO, Open Graph, fonts, theme bootstrap), header, footer and the theme toggle.
 * Fonts are self-hosted from @fontsource. Two voices: a serif for what people wrote, a monospace for
 * what the build measured (dates, durations, counts, code).
 *   Source Serif 4 (variable, with optical sizes)  Latin text; headings get the display cut by size
 *   Noto Serif SC 400 / 600                         Chinese text (the Source Han Serif design)
 *   IBM Plex Mono 400 / 500 / 600                   measured values and code
 * Source Serif renders any weight; for Noto Serif SC, CSS font matching takes 500 down to 400 and 700
 * down to 600, so one CSS weight always pairs the two scripts.
 * Noto Serif SC is split into unicode-range slices, so a page only downloads the slices it uses.
 */
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
// Noto Serif SC's @font-face list is large (one rule per slice and weight), so it is emitted as its own
// stylesheet and linked at the end of <body>, where it does not block rendering.
import notoSerifSc from '../styles/noto-serif-sc.css?url';

// "SC Punct": inside Chinese text, quotes, dashes, the ellipsis and the interpunct come from Noto Serif SC
// (full width) instead of the Latin face. These are the self-hosted Noto slices that hold those code points.
import punct400 from '@fontsource/noto-serif-sc/files/noto-serif-sc-latin-400-normal.woff2?url';
import punct600 from '@fontsource/noto-serif-sc/files/noto-serif-sc-latin-600-normal.woff2?url';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';
import { DEFAULT_LOCALE, LANG, localeOfPath, localePath, OG_LOCALE, otherLocale, unlocalizedPath, type Locale } from '../lib/i18n';
import { UI } from '../lib/ui';

interface Props {
  /** Edition of the page; by default the one its URL names (/en/... is English). */
  locale?: Locale;
  /**
   * The same page in the other edition. By default the same path with the other prefix, since every
   * index page exists in both; a post passes its translation, or null when it has none.
   */
  alternate?: string | null;
  /** Page name; omitted on the home page, whose title is just the site name. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  article?: { published: Date; modified?: Date; tags: string[] };
  /** Extra class on <main>. */
  mainClass?: string;
  /** Canonical path when it differs from the URL (the 404 page is served from /404.html). */
  canonicalPath?: string;
  /** Keep the page out of search indexes (the 404 page). */
  noindex?: boolean;
}

const { locale = localeOfPath(Astro.url.pathname) } = Astro.props;
const t = UI[locale];
const other = otherLocale(locale);
const {
  alternate = localePath(other, unlocalizedPath(Astro.url.pathname)),
  title,
  description = t.siteDescription,
  type = 'website',
  article,
  mainClass,
  canonicalPath,
  noindex,
} = Astro.props;
const site = Astro.site ?? SITE.url;
const fullTitle = title ? `${title} | ${t.siteName}` : t.siteName;
const ogTitle = title ?? t.siteName;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const ogImage = new URL(SITE.ogImage.path, site).href;
// hreflang: both editions of the page, and the Chinese one as the default for other languages
// (not on the 404 page, whose "other edition" is just the English home page)
const alternates = alternate && !noindex
  ? [
      { lang: LANG[locale], href: canonical },
      { lang: LANG[other], href: new URL(alternate, site).href },
      { lang: 'x-default', href: locale === DEFAULT_LOCALE ? canonical : new URL(alternate, site).href },
    ]
  : [];

const punctFaces = [
  [400, punct400],
  [600, punct600],
]
  .map(
    ([weight, url]) =>
      `@font-face{font-family:"SC Punct";font-style:normal;font-weight:${weight};font-display:swap;` +
      `src:url(${url}) format("woff2");unicode-range:U+00B7,U+2014,U+2018-2019,U+201C-201D,U+2026}`,
  )
  .join('');
---
<!doctype html>
<html lang={LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F6F3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#11161C" />
    <script is:inline>
      /* the browser bar follows a theme the reader picked, not only the system (the colors are --bg) */
      function setThemeColor(t) {
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.setAttribute('content', t === 'dark' ? '#11161C' : '#F5F6F3');
        });
      }
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          setThemeColor(t);
        }
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((link) => <link rel="alternate" hreflang={link.lang} href={link.href} />)}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {alternates.length > 0 && <meta property="og:locale:alternate" content={OG_LOCALE[other]} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE.ogImage.width)} />
    <meta property="og:image:height" content={String(SITE.ogImage.height)} />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={t.siteName} href={localePath(locale, '/rss.xml')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={punctFaces}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <SiteHeader locale={locale} alternate={alternate} />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <slot name="after-main" />
    <SiteFooter locale={locale} />
    <script is:inline>
      /* theme toggle: follows the system until the reader picks a theme, which is remembered */
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var buttons = document.querySelectorAll('[data-theme-toggle]');
        function effective() { return root.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function sync() {
          var next = effective() === 'dark' ? 'light' : 'dark';
          buttons.forEach(function (b) {
            var label = b.getAttribute(next === 'dark' ? 'data-label-dark' : 'data-label-light');
            b.setAttribute('aria-label', label);
            b.title = label;
          });
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            var next = effective() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            setThemeColor(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            sync();
          });
        });
        if (mq.addEventListener) mq.addEventListener('change', sync);
        sync();
      })();
    </script>
    <slot name="scripts" />
    <link rel="stylesheet" href={notoSerifSc} />
  </body>
</html>
