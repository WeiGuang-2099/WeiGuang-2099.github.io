---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="There is no page at this address on Dawning."
  mainClass="container article-layout no-rail"
  canonicalPath="/404.html"
  noindex
>
  <article class="sheet sheet-short" aria-labelledby="post-title">
    <header class="post-head">
      <h1 id="post-title">Page not found</h1>
      <p class="dek">There is no page at this address. The link may be mistyped, or the page may have moved.</p>
      <dl class="attrs">
        <div>
          <dt>Status</dt>
          <dd><span class="num">404</span> Not Found</dd>
        </div>
        <div>
          <dt>Try</dt>
          <dd>
            <ul class="links">
              <li><a class="text-link" href="/">Home</a></li>
              <li><a class="text-link" href="/archive/">Archive</a></li>
              <li><a class="text-link" href="/tags/">Tags</a></li>
            </ul>
          </dd>
        </div>
      </dl>
    </header>
  </article>
</BaseLayout>
