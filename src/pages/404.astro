---
/*
 * GitHub Pages serves this one page for every missing address, in either edition, so it speaks both
 * languages. The language switch leads to the English home page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  locale="zh"
  alternate="/en/"
  title="页面不存在"
  description="这个地址没有页面。There is no page at this address."
  mainClass="container article-layout no-rail"
  canonicalPath="/404.html"
  noindex
>
  <article class="sheet sheet-short" aria-labelledby="post-title">
    <header class="post-head">
      <h1 id="post-title">页面不存在 <span class="h1-alt" lang="en">Page not found</span></h1>
      <p class="dek">这个地址没有页面。链接可能拼错了，或者页面已经移走。</p>
      <p class="dek" lang="en">There is no page at this address. The link may be mistyped, or the page may have moved.</p>
      <dl class="attrs">
        <div>
          <dt>状态 <span lang="en">Status</span></dt>
          <dd><span class="num">404</span> Not Found</dd>
        </div>
        <div>
          <dt>去往 <span lang="en">Try</span></dt>
          <dd>
            <ul class="links">
              <li><a class="text-link" href="/">首页</a></li>
              <li><a class="text-link" href="/archive/">归档</a></li>
              <li><a class="text-link" href="/en/" lang="en">Home</a></li>
              <li><a class="text-link" href="/en/archive/" lang="en">Archive</a></li>
            </ul>
          </dd>
        </div>
      </dl>
    </header>
  </article>
</BaseLayout>
