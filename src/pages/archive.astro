---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, listAxis, summarize, type PostSummary } from '../lib/posts';
import { plural } from '../lib/format';

const all = await summarize(await getPosts());
const axis = listAxis(all.map((s) => s.minutes));
const totalMinutes = all.reduce((sum, s) => sum + s.minutes, 0);

// Newest year first; posts inside a year are already newest first.
const years = new Map<number, PostSummary[]>();
for (const item of all) {
  const year = item.post.data.pubDate.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), item]);
}
---
<BaseLayout title="Archive" description="Every post on Dawning, newest first, with its reading time.">
  <div class="container page">
    <header class="page-head">
      <h1>Archive</h1>
      <p class="page-dek">{plural(all.length, 'post')}, {totalMinutes} min of reading. Spans show reading time on a 0 to {axis.max} min scale.</p>
    </header>

    {[...years].map(([year, items]) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <div class="section-head">
          <h2 id={`y${year}`}>{year}</h2>
          <p class="legend">{plural(items.length, 'post')}</p>
        </div>
        <PostList items={items} axis={axis} />
      </section>
    ))}
    {all.length === 0 && <p class="empty">Nothing published yet.</p>}
  </div>
</BaseLayout>
