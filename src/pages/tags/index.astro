---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, laneVar, listAxis, summarize, tagUrl } from '../../lib/posts';
import { groupByTag } from '../../lib/tags';
import { pct, plural, tickLabel } from '../../lib/format';

const all = await summarize(await getPosts());
const groups = groupByTag(all);
const axis = listAxis(groups.map((g) => g.minutes));
const intervals = axis.ticks.length - 1;
---
<BaseLayout title="Tags" description="Posts on Dawning by tag, with the total reading time behind each tag.">
  <div class="container page">
    <header class="page-head">
      <h1>Tags</h1>
      <p class="page-dek">{plural(groups.length, 'tag')} across {plural(all.length, 'post')}. Bars show the total reading time behind each tag, colored by topic.</p>
    </header>

    {groups.length > 0 ? (
      <div class="container-bleed">
        <div class="panel wf tagwf" style={`--axis-max: ${axis.max}; --intervals: ${intervals}`}>
          <div class="wf-head" aria-hidden="true">
            <span class="c-post">Tag</span>
            <span class="c-count">Posts</span>
            <div class="c-time">
              <div class="ruler">
                {axis.ticks.map((tick, i) => (
                  <span style={`--at: ${pct(tick, axis.max)}`}>
                    {tickLabel(tick)}{i === axis.ticks.length - 1 && <span class="unit">min</span>}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <ul class="wf-rows">
            {groups.map((group) => (
              <li class="wf-row" style={`--dur: ${group.minutes}`}>
                <div class="c-post">
                  <a class="tag-name" href={tagUrl(group.name)}>
                    {group.lane && <span class="sw" style={`--lane: ${laneVar(group.lane)}`} aria-hidden="true"></span>}
                    {group.name}
                  </a>
                </div>
                <span class="c-count">{plural(group.items.length, 'post')}</span>
                <div class="c-time">
                  <div class="span-row">
                    <span class="bar bar-stack" aria-hidden="true">
                      {group.lanes.map(({ lane, minutes }) => <span style={`--lane: ${laneVar(lane)}; --v: ${minutes}`}></span>)}
                    </span>
                    <span class="dur"><span class="sr-only">Total reading time: </span>{group.minutes} min</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <p class="empty">No tags yet.</p>
    )}
  </div>
</BaseLayout>
