---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, LANE_ORDER, laneVar, listAxis, summarize } from '../lib/posts';
import { SITE } from '../lib/site';
import { localePath, type Locale } from '../lib/i18n';
import { UI } from '../lib/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const LATEST = 10;
const all = await summarize(await getPosts(locale));
const axis = listAxis(all.map((s) => s.minutes));
const latest = all.slice(0, LATEST);

// The whole archive as one 100% bar: total reading time per topic lane (lanes without posts are left out).
// It only says something once there are two lanes to compare.
const mix = LANE_ORDER.map((lane) => ({
  lane,
  minutes: all.filter((s) => s.lane === lane).reduce((sum, s) => sum + s.minutes, 0),
})).filter((entry) => entry.minutes > 0);
---
<BaseLayout locale={locale}>
  <section class="hero container" aria-labelledby="hero-name">
    <!-- the name written in a practice grid (tianzige), whose guide lines are drawn as the
         dash-dot centre lines of an engineering drawing; the inscription beside it is the line
         from the Book of Songs the name comes from, signed with a seal -->
    <div class="specimen">
      <div class="specimen-name">
        <h1 id="hero-name" class="cells">
          <span class="cell" lang="zh-CN" aria-hidden="true">缉</span><span class="cell" lang="zh-CN" aria-hidden="true">熙</span>
          {locale === 'zh' ? (
            <span class="sr-only">{SITE.nameZh}（<span lang="en">{SITE.name}</span>）</span>
          ) : (
            <span class="sr-only">{SITE.name} (<span lang="zh-CN">{SITE.nameZh}</span>)</span>
          )}
        </h1>
        <dl class="gloss">
          <div><dt lang="zh-Latn-pinyin">jī</dt><dd>{t.home.gloss.ji}</dd></div>
          <div><dt lang="zh-Latn-pinyin">xī</dt><dd>{t.home.gloss.xi}</dd></div>
        </dl>
      </div>
      <figure class="inscription" lang="zh-CN">
        <blockquote><p>日就月将，<br />学有缉熙于光明。</p></blockquote>
        <figcaption>诗经·周颂·敬之<span class="seal" aria-hidden="true">缉熙</span></figcaption>
      </figure>
    </div>
    <div class="hero-text">
      {locale === 'zh' ? (
        <p class="lead">我是缉熙（<span lang="en">Dawning</span>），一名 AI 工程师，做检索增强生成（RAG）、多智能体编排和 LLM 应用。这里记下在生产环境里站得住脚的东西：设计笔记、失败模式、评测，以及偶尔让我改变看法的结果。</p>
      ) : (
        <p class="lead">I'm Dawning (<span lang="zh-CN">缉熙</span>), an AI engineer working on retrieval-augmented generation, multi-agent orchestration and LLM applications. I write here about what holds up in production: design notes, failure modes, evaluations, and the occasional result that changed my mind.</p>
      )}
      <ul class="links">
        <li><a class="text-link" href={SITE.github}>GitHub</a></li>
        <li><a class="text-link" href={localePath(locale, '/rss.xml')}>RSS</a></li>
        <li><a class="text-link" href={localePath(locale, '/about/')}>{t.nav.about}</a></li>
      </ul>
      {mix.length > 1 && (
        <figure class="mix">
          <figcaption>{t.home.mix}</figcaption>
          <div class="mix-bar" aria-hidden="true">
            {mix.map(({ lane, minutes }) => <span style={`--lane: ${laneVar(lane)}; --v: ${minutes}`}></span>)}
          </div>
          <ul class="mix-key">
            {mix.map(({ lane, minutes }) => (
              <li><span class="sw" style={`--lane: ${laneVar(lane)}`} aria-hidden="true"></span>{lane} <span class="num">{minutes} min</span></li>
            ))}
          </ul>
        </figure>
      )}
    </div>
  </section>

  <section class="writing container" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">{t.home.writing}</h2>
      <p class="legend">{t.home.legend(axis.max)}</p>
    </div>
    {latest.length > 0 ? (
      <PostList locale={locale} items={latest} axis={axis} />
    ) : (
      <p class="empty">{t.empty}</p>
    )}
    <p class="after-list"><a class="text-link" href={localePath(locale, '/archive/')}>{t.home.allPosts(all.length, LATEST)}</a></p>
  </section>
</BaseLayout>
