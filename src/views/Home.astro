---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, listAxis, summarize } from '../lib/posts';
import { CATEGORIES, CATEGORY_IDS, categoryUrl, groupByCategory, laneVar } from '../lib/categories';
import { SITE } from '../lib/site';
import { localePath, type Locale } from '../lib/i18n';
import { UI } from '../lib/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
/** newest posts listed per category; the rest are on the category's page */
const SHOWN = 3;
const all = await summarize(await getPosts(locale));
const axis = listAxis(all.map((s) => s.minutes));
const groups = groupByCategory(all);
const name = (id: (typeof CATEGORY_IDS)[number]) => CATEGORIES[id].name[locale];

// One block per category, in the categories' order. An upcoming category without posts keeps its place
// with a placeholder; any other category without posts is left out.
const blocks = CATEGORY_IDS.flatMap((id) => {
  const group = groups.find((g) => g.id === id);
  return group || CATEGORIES[id].upcoming ? [{ id, group }] : [];
});

// The whole archive as one 100% bar: total reading time per category. It only says something once
// there are two categories to compare.
const mix = groups;
---
<BaseLayout locale={locale}>
  <section class="hero container" aria-labelledby="hero-name">
    <!-- the name written in a practice grid (tianzige), whose guide lines are drawn as the
         dash-dot centre lines of an engineering drawing; the inscription beside it is the line
         from the Book of Songs the name comes from, signed with a seal -->
    <div class="specimen">
      <div class="specimen-name">
        <h1 id="hero-name" class="cells">
          <span class="cell" lang="zh-CN" aria-hidden="true">缉</span><span class="cell" lang="zh-CN" aria-hidden="true">熙</span>
          {locale === 'zh' ? (
            <span class="sr-only">{SITE.nameZh}（<span lang="en">{SITE.name}</span>）</span>
          ) : (
            <span class="sr-only">{SITE.name} (<span lang="zh-CN">{SITE.nameZh}</span>)</span>
          )}
        </h1>
        <dl class="gloss">
          <div><dt lang="zh-Latn-pinyin">jī</dt><dd>{t.home.gloss.ji}</dd></div>
          <div><dt lang="zh-Latn-pinyin">xī</dt><dd>{t.home.gloss.xi}</dd></div>
        </dl>
      </div>
      <figure class="inscription" lang="zh-CN">
        <blockquote><p>日就月将，<br />学有缉熙于光明。</p></blockquote>
        <figcaption>诗经·周颂·敬之<span class="seal" aria-hidden="true">缉熙</span></figcaption>
      </figure>
    </div>
    <div class="hero-text">
      {locale === 'zh' ? (
        <p class="lead">我是缉熙（<span lang="en">Dawning</span>），一名 AI 工程师，做检索增强生成（RAG）、多智能体编排和 LLM 应用。这里记下在生产环境里站得住脚的东西：设计笔记、失败模式、评测，以及偶尔让我改变看法的结果。</p>
      ) : (
        <p class="lead">I'm Dawning (<span lang="zh-CN">缉熙</span>), an AI engineer working on retrieval-augmented generation, multi-agent orchestration and LLM applications. I write here about what holds up in production: design notes, failure modes, evaluations, and the occasional result that changed my mind.</p>
      )}
      <ul class="links">
        <li><a class="text-link" href={SITE.github}>GitHub</a></li>
        <li><a class="text-link" href={localePath(locale, '/rss.xml')}>RSS</a></li>
        <li><a class="text-link" href={localePath(locale, '/about/')}>{t.nav.about}</a></li>
      </ul>
      {mix.length > 1 && (
        <figure class="mix">
          <figcaption>{t.home.mix}</figcaption>
          <div class="mix-bar" aria-hidden="true">
            {mix.map(({ id, minutes }) => <span style={`--lane: ${laneVar(id)}; --v: ${minutes}`}></span>)}
          </div>
          <ul class="mix-key">
            {mix.map(({ id, minutes }) => (
              <li><span class="sw" style={`--lane: ${laneVar(id)}`} aria-hidden="true"></span>{name(id)} <span class="num">{minutes} min</span></li>
            ))}
          </ul>
        </figure>
      )}
    </div>
  </section>

  {blocks.map(({ id, group }) => (
    <section class="writing container" aria-labelledby={`cat-${id}`}>
      <div class="section-head">
        <h2 id={`cat-${id}`} class="cat-head">
          <span class="sw sw-lg" style={`--lane: ${laneVar(id)}`} aria-hidden="true"></span>{name(id)}
          {!group && <span class="draft-mark">{CATEGORIES[id].upcoming?.[locale]}</span>}
        </h2>
        {group && <p class="legend">{t.home.categoryLegend(group.items.length, group.minutes)}</p>}
      </div>
      {group ? (
        <Fragment>
          <PostList locale={locale} items={group.items.slice(0, SHOWN)} axis={axis} showCategory={false} showTags={false} />
          {group.items.length > SHOWN && (
            <p class="after-list"><a class="text-link" href={categoryUrl(id, locale)}>{t.home.allInCategory(name(id), group.items.length)}</a></p>
          )}
        </Fragment>
      ) : (
        <p class="cat-empty">{t.home.upcomingNote}</p>
      )}
    </section>
  ))}
  {all.length === 0 && (
    <section class="writing container">
      <p class="empty">{t.empty}</p>
    </section>
  )}
</BaseLayout>
